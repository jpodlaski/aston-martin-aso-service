# Line endings for scripts / sources (Windows-safe clones)
* text=auto eol=lf

/mvnw text eol=lf
*.cmd text eol=crlf

# Keep binary assets as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.jar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Sources
*.java text eol=lf
*.jsx text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.clj text eol=lf
*.edn text eol=lf
*.properties text eol=lf
*.sql text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
